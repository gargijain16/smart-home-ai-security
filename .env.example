# Backend (copy to backend/.env or export before starting uvicorn)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173   # explicit origins only; add your Vercel URL in production
MODELS_DIR=./models
REPORTS_DIR=./reports
DB_PATH=./data/processed/events.db                          # use ":memory:" on hosts with ephemeral disks
SIM_SEED=42
SIM_TICK_SECONDS=1.5
MAX_UPLOAD_MB=25
MAX_UPLOAD_ROWS=50000
